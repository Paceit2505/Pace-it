# Banco de dados
DATABASE_URL="postgresql://user:password@localhost:5432/paceit_b2b"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Servidor
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Bling ERP v3
BLING_CLIENT_ID="your-bling-client-id"
BLING_CLIENT_SECRET="your-bling-client-secret"
BLING_WEBHOOK_SECRET="your-bling-webhook-secret"

# PagBrasil
PAGBRASIL_API_KEY="your-pagbrasil-api-key"
PAGBRASIL_WEBHOOK_SECRET="your-pagbrasil-webhook-secret"
PAGBRASIL_BASE_URL="https://api.pagbrasil.com"

# Firebase FCM
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PRIVATE_KEY="your-firebase-private-key"
FIREBASE_CLIENT_EMAIL="your-firebase-client-email"

# Cloudflare R2
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY="your-r2-access-key"
R2_SECRET_KEY="your-r2-secret-key"
R2_BUCKET_NAME="pace-it-images"
R2_PUBLIC_URL="https://images.paceit.com.br"

# Frete
FREIGHT_MIN_VALUE_FREE=500
FREIGHT_FIXED_VALUE=25

# Frontend URL (para CORS)
FRONTEND_URL="http://localhost:8081"
